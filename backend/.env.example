# 大模型（华为云 MaaS）
MAAS_API_KEY=
MAAS_MODEL=deepseek-v4-flash
MAAS_BASE_URL=https://api.modelarts-maas.com/v2/chat/completions

# 服务
APP_PORT=8000
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# IoTDA 设备接入（全部留空 = 本地模拟模式，AI 问答与前端演示不受影响）
# ---------------------------------------------------------------------------

# 设备侧 MQTT 直连（8883 / TLS）。host 形如 xxxxxxxx.st1.iotda-device.cn-north-4.myhuaweicloud.com
IOTDA_MQTT_HOST=
IOTDA_MQTT_PORT=8883
IOTDA_DEVICE_ID=
IOTDA_DEVICE_SECRET=

# 平台侧 AMQP 订阅（5671 / TLS），用于接收设备上报数据
IOTDA_AMQP_HOST=
IOTDA_AMQP_PORT=5671
IOTDA_AMQP_ACCESS_KEY=
IOTDA_AMQP_ACCESS_CODE=
IOTDA_AMQP_QUEUE=DefaultQueue
IOTDA_INSTANCE_ID=

# 本地落库路径（SQLite）。相对路径按 backend/ 目录解析；留空默认 data/iot.db
IOTDB_PATH=

# 设备 → 老人映射：告警弹窗展示的告警对象
IOTDA_ELDER_ID=E01
IOTDA_ELDER_NAME=张桂芳

# 阈值（留空使用与前端 store.js DEFAULT_THRESHOLDS 一致的缺省值）
IOTDA_HR_HIGH=105
IOTDA_HR_LOW=50
IOTDA_SPO2_LOW=92
IOTDA_SBP_HIGH=150
# 同一设备同一类型告警的冷却秒数
IOTDA_ALERT_COOLDOWN=60

# 云端命令下发（远程重启等）：region / project_id / AK / SK 全部填写才启用
IOTDA_REGION=
IOTDA_PROJECT_ID=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=